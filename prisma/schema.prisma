generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum BlogPostLanguage {
  NL
  EN
}

model BlogPost {
  id             String           @id @default(cuid())
  title          String
  slug           String
  language       BlogPostLanguage @default(NL)
  summary        String
  content        String
  category       String?
  tags           String[]         @default([])
  authorName     String
  authorBio      String?
  authorImage    String?
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  status         BlogPostStatus   @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([slug, language])
  @@index([status, language, publishedAt])
}


model DemoRequest {
  id               String   @id @default(cuid())
  name             String
  company          String
  email            String
  phone            String?
  preferredContact String   @default("EMAIL")
  message          String?
  language         String   @default("NL")
  status           String   @default("NEW")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}


model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  subject   String?
  message   String
  language  String   @default("NL")
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model RequestNote {
  id          String   @id @default(cuid())
  requestType String
  requestId   String
  note        String
  createdAt   DateTime @default(now())

  @@index([requestType, requestId, createdAt])
}
